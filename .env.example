# Copia este archivo como .env (raíz para docker-compose, o backend/.env para desarrollo local).
# Todos los valores son de EJEMPLO: cámbialos en cualquier entorno real.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=restaurante
POSTGRES_USER=restaurante
POSTGRES_PASSWORD=restaurante

# --- API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://restaurante:restaurante@localhost:5432/restaurante
# Mínimo 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-de-ejemplo-de-32-caracteres-o-mas
JWT_EXPIRES_IN=8h
# Costo de bcrypt (12 recomendado en producción; 4 en pruebas)
BCRYPT_ROUNDS=12
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info
# true = carga datos demo al arrancar si la base está vacía
SEED_ON_START=true

# --- Frontend (opcional; por defecto usa rutas relativas /api y /socket.io) ---
# VITE_API_URL=
# VITE_SOCKET_URL=
# VITE_PROXY_TARGET=http://localhost:3000
